PORT=3210
# Local account workspace defaults to loopback. For a deployed HTTPS origin,
# configure the trusted public origin and bind address explicitly.
# APP_ORIGIN=https://your-domain.example
# HOST=0.0.0.0
# Pull this image once before running verification: docker pull python:3.12-alpine
PYTHON_IMAGE=python:3.12-alpine
# Optional: trusted Python interpreter with requirements-modal.txt installed.
# Default: .venv/Scripts/python.exe on Windows, .venv/bin/python elsewhere.
# MODAL_PYTHON=
# Optional: a trusted provider's OpenAI-compatible chat completions URL.
# Configure an available Meta model offered by your provider for the hackathon.
AI_CHAT_URL=
AI_API_KEY=
AI_MODEL=

# Optional trusted multi-language runtime image; build backend/polyglot first.
# POLYGLOT_IMAGE=invarith-polyglot:2

# Transactional email. Leave these blank to keep email delivery disabled.
# Use an authenticated SMTP account; port 465 uses TLS, port 587 requires STARTTLS.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=
